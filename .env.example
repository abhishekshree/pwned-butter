DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require
# Which vendor to use: openrouter or groq.
LLM_PROVIDER=groq
# Only that vendor's key is read.

# OpenRouter
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_FALLBACKS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Groq (free tier: 30 req/min, 1000 req/day)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACKS=openai/gpt-oss-120b

# Set to a JSONL path to write records locally instead of Postgres.
# LOCAL_WRITER_PATH=/tmp/fda-actions.jsonl
