DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require
GEMINI_API_KEY=your_gemini_api_key_from_aistudio.google.com
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=your_openrouter_api_key_optional
# Must match a live :free ID (see OPENROUTER_FALLBACKS in src/llm/openrouter.rs).
# NOTE: free endpoints offer no ZDR — an account requiring zero data retention
# 404s on all of them until the privacy setting is relaxed.
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
# Dashboard cache bust (src/bin/cache_bust.rs -> web/src/app/api/revalidate).
# REVALIDATE_SECRET must match the Vercel project env value.
REVALIDATE_URL=https://<your-domain>/api/revalidate
REVALIDATE_SECRET=your_random_secret_here